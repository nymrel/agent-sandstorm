{
  "name": "@nymrel/agent-sandstorm",
  "version": "0.1.0",
  "packageManager": "npm@11.19.1",
  "description": "Experimental agent execution guardrails, workspace recovery, cooperative proxying, and audit utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sandstorm": "./bin/sandstorm.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cow": {
      "import": {
        "types": "./dist/cow/index.d.ts",
        "default": "./dist/cow/index.js"
      }
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy/index.d.ts",
        "default": "./dist/proxy/index.js"
      }
    },
    "./limiter": {
      "import": {
        "types": "./dist/limiter/index.d.ts",
        "default": "./dist/limiter/index.js"
      }
    },
    "./audit": {
      "import": {
        "types": "./dist/audit/index.d.ts",
        "default": "./dist/audit/index.js"
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node",
    "test:node": "npm run build && node test/runner.js && npm run test:build-contract",
    "test:build-contract": "node --test test/build-contract.test.js",
    "test:python": "python scripts/test_python.py",
    "check": "npm run test:node && npm run test:python && npm run check:package",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "bin/sandstorm.js",
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "RELEASE_READINESS.md",
    "SECURITY.md"
  ],
  "keywords": [
    "agent-sandbox",
    "outbound-proxy",
    "copy-on-write",
    "workspace-isolation",
    "rollback-engine",
    "secret-exfiltration-prevention",
    "spend-limiter",
    "ai-agents",
    "autonomous-agents",
    "nymrel"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "homepage": "https://github.com/nymrel/agent-sandstorm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymrel/agent-sandstorm.git"
  },
  "bugs": {
    "url": "https://github.com/nymrel/agent-sandstorm/issues"
  },
  "engines": {
    "node": ">=22.19 <27",
    "npm": ">=11.5 <12"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
